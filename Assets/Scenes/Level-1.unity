--- !u!114 &1390221749
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1390221746}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 058aecdb36ccbea4a9e4d475feec0dbc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  doorController: {fileID: 1390221748}
  cabinZone: {fileID: 1418518380}
  approachZone: {fileID: 257183790}
  doorwayZone: {fileID: 1807511448}
  stayInCabinSeconds: 2
  requirePowerRestored: 1
  powerScenario: {fileID: 0}
  powerRequiredHint: "\u041B\u0438\u0444\u0442 \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.
    \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u043F\u0438\u0442\u0430\u043D\u0438\u0435
    \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0430."
  powerHintCooldown: 2
  finalNarrativeText: "\u0421\u0415\u041A\u0422\u041E\u0420 \u041B\u0410\u0411\u041E\u0420\u0410\u0422\u041E\u0420\u0418\u0418
    \u041E\u0421\u0422\u0410\u0412\u041B\u0415\u041D \u041F\u041E\u0417\u0410\u0414\u0418.\n\n\u041F\u043E
    \u0430\u0432\u0430\u0440\u0438\u0439\u043D\u043E\u043C\u0443 \u0436\u0443\u0440\u043D\u0430\u043B\u0443
    \u044F\u0441\u043D\u043E \u043E\u0434\u043D\u043E: \u0446\u0435\u043F\u043D\u0430\u044F
    \u0440\u0435\u0430\u043A\u0446\u0438\u044F \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C
    \u043D\u0435 \u0441 \u043F\u043E\u0436\u0430\u0440\u0430 \u0438 \u043D\u0435
    \u0441 \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E \u0432\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u044F,
    \u0430 \u0441 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0438 \u043D\u0435\u0439\u0440\u043E\u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430
    ARK. \u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u043D\u0430\u0447\u0430\u043B\u0430
    \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C
    \u0441\u0440\u0435\u0434\u0443, \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F
    \u0446\u0438\u043A\u043B \u043F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0439
    \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043E\u0448\u0438\u0431\u043A\u0438.\n\n\u0422\u044B
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B \u0434\u043E\u0441\u0442\u0443\u043F
    \u043A \u043B\u0438\u0444\u0442\u0443, \u043D\u043E \u0441\u043F\u0443\u0441\u043A
    \u0432\u043D\u0438\u0437 \u2014 \u044D\u0442\u043E \u043D\u0435 \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u044F.
    \u042D\u0442\u043E \u0432\u0445\u043E\u0434 \u0432 \u0437\u043E\u043D\u0443,
    \u0433\u0434\u0435 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0430\u0432\u0430\u0440\u0438\u0438
    \u0432\u0441\u0435 \u0435\u0449\u0435 \u0430\u043A\u0442\u0438\u0432\u0435\u043D.\n\n\u041F\u0420\u041E\u0422\u041E\u0422\u0418\u041F
    \u0417\u0410\u0412\u0415\u0420\u0428\u0415\u041D: \u041F\u0435\u0440\u0432\u0430\u044F
    \u043B\u043E\u043A\u0430\u0446\u0438\u044F \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u0430."
  typewriterCharsPerSecond: 25
  blackScreenHoldSeconds: 2.5
  keepBlackScreenAtEnd: 1
